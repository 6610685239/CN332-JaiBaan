{
  "name": "announcement-system",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend-web",
    "packages/shared"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace=backend\" \"npm run dev --workspace=frontend-web\"",
    "dev:backend": "npm run dev --workspace=backend",
    "dev:frontend": "npm run dev --workspace=frontend-web",
    "build": "npm run build --workspace=frontend-web",
    "db:migrate": "npm run migrate --workspace=backend",
    "db:generate": "npm run generate --workspace=backend",
    "db:studio": "npm run studio --workspace=backend"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}